erDiagram
    audit_log {
        bigint id PK
        bigint user_id "nullable"
        varchar action
        varchar auditable_type "nullable"
        varchar auditable_id "nullable"
        varchar description "nullable"
        json old_values "nullable"
        json new_values "nullable"
        varchar ip_address "nullable"
        varchar user_agent "nullable"
        timestamp created_at
    }
    calendar_events {
        bigint id PK
        varchar title
        text description "nullable"
        varchar category
        date starts_on
        date ends_on "nullable"
        time start_time "nullable"
        time end_time "nullable"
        int created_by_emp_id FK "nullable"
        int updated_by_emp_id FK "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    canvasForms {
        bigint id PK
        varchar CF_Number
        varchar pr_number
        varchar CF_to_be_Open
        varchar CF_delivery_Period
        varchar CF_canvasser "nullable"
        varchar CF_made_by
        varchar CF_bac_date
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    department_signatory_set {
        bigint signatory_set_id PK, FK
        bigint department_id PK, FK
    }
    departments {
        bigint id PK
        varchar Department_Name UK
        varchar Department_Code UK
        varchar Department_Desc "nullable"
        tinyint is_active
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    document_settings {
        bigint id PK
        varchar key UK
        text value "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    iar {
        bigint id PK
        varchar iar_number
        varchar invoice_number "nullable"
        date invoice_date "nullable"
        varchar delivery_status "nullable"
        varchar PO_Number FK
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    iar_items {
        bigint id PK
        bigint iar_id FK
        bigint purchase_request_item_id FK
        int quantity_received
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    items {
        bigint id PK
        varchar item_desc UK
        decimal item_price
        varchar item_unit
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    permission_role {
        bigint role_id PK, FK
        bigint permission_id PK, FK
    }
    permissions {
        bigint id PK
        varchar name UK
        varchar label
        varchar group
        varchar description "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    purchase_order {
        bigint id PK
        varchar PO_Number UK "nullable"
        varchar PO_Supplier "nullable"
        text PO_Description "nullable"
        datetime PO_Date "nullable"
        datetime received_at "nullable"
        int received_by_emp_id FK "nullable"
        varchar PR_Number FK, UK
        int poNumbered_by FK "nullable"
        varchar RIS_Number "nullable"
        datetime RIS_Date "nullable"
        int risNumbered_by FK "nullable"
        varchar SSMI_Number "nullable"
        datetime SSMI_Date "nullable"
        datetime released_at "nullable"
        int released_by_emp_id FK "nullable"
        varchar released_to "nullable"
        varchar released_to_department "nullable"
        text release_remarks "nullable"
        int ssmiNumbered_by "nullable"
        varchar fund_source "nullable"
        int status FK
        varchar delivery_status "nullable"
        int cancelled_by_emp_id FK "nullable"
        datetime cancelled_at "nullable"
        text cancellation_reason "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    purchase_order_tags {
        bigint id PK
        bigint purchase_order_id FK
        bigint tracker_tag_id FK
        text note "nullable"
        int tagged_by_emp_id FK "nullable"
        datetime resolved_at "nullable"
        int resolved_by_emp_id FK "nullable"
        text resolution_note "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    purchase_request_items {
        bigint id PK
        bigint purchase_request_id FK
        varchar item_name "nullable"
        varchar item_desc "nullable"
        varchar unit
        int quantity
        decimal estimated_unit_cost
        decimal total_estimated_cost
        decimal bidding_unit_cost "nullable"
        decimal total_bidding_unit_cost "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    purchase_requests {
        bigint id PK
        varchar pr_number UK
        text requester_department
        text mode_of_procurement "nullable"
        text remarks_or_notes "nullable"
        text reason_to_decline "nullable"
        text cancellation_reason "nullable"
        int verify_by_emp_id FK "nullable"
        int encoded_by "nullable"
        int decline_by_emp_id "nullable"
        int cancelled_by_emp_id FK "nullable"
        int status FK
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
        datetime verified_At "nullable"
        datetime encoded_at "nullable"
        datetime declined_At "nullable"
        datetime cancelled_at "nullable"
        json signatory_set_ids "nullable"
    }
    record_classes {
        bigint id PK
        varchar code UK
        varchar title
        text description "nullable"
        varchar rds_source
        varchar rds_item_no
        smallint retention_years "nullable"
        varchar retention_trigger
        tinyint is_permanent
        tinyint is_vital
        varchar sensitivity
        tinyint is_active
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    records {
        bigint id PK
        bigint record_class_id FK
        varchar title
        varchar reference_no "nullable"
        date record_date
        varchar originating_office
        varchar custodian
        varchar physical_location
        varchar box_no "nullable"
        date retention_starts_on "nullable"
        date eligible_for_disposal_on "nullable"
        varchar status
        timestamp archived_at "nullable"
        varchar archived_by "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    role {
        bigint id PK
        varchar role_name
        varchar section
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    saved_queries {
        bigint id PK
        varchar name
        varchar description "nullable"
        text sql
        tinyint is_shared
        int created_by_emp_id FK
        int run_count
        datetime last_run_at "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    signatory_sets {
        bigint id PK
        varchar document
        varchar name
        tinyint is_default
        json signers
        json fixed "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    status {
        bigint id PK
        int status_code UK
        varchar status_desc
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    tracker_tags {
        bigint id PK
        varchar name UK
        varchar description "nullable"
        varchar color
        tinyint holds_order
        tinyint is_active
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    users {
        bigint id PK
        int emp_id UK
        varchar emp_fname
        varchar emp_lname
        bigint role_id FK
        bigint status_id FK
        varchar password
        timestamp temporary_password_expires_at "nullable"
        varchar remember_token "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    users |o--o{ calendar_events : "created_by_emp_id"
    users |o--o{ calendar_events : "updated_by_emp_id"
    departments ||--o{ department_signatory_set : "department_id"
    signatory_sets ||--o{ department_signatory_set : "signatory_set_id"
    purchase_order ||--o{ iar : "PO_Number"
    iar ||--o{ iar_items : "iar_id"
    purchase_request_items ||--o{ iar_items : "purchase_request_item_id"
    permissions ||--o{ permission_role : "permission_id"
    role ||--o{ permission_role : "role_id"
    users |o--o{ purchase_order : "cancelled_by_emp_id"
    users |o--o{ purchase_order : "poNumbered_by"
    purchase_requests ||--o| purchase_order : "PR_Number"
    users |o--o{ purchase_order : "received_by_emp_id"
    users |o--o{ purchase_order : "released_by_emp_id"
    users |o--o{ purchase_order : "risNumbered_by"
    status ||--o{ purchase_order : "status"
    purchase_order ||--o{ purchase_order_tags : "purchase_order_id"
    users |o--o{ purchase_order_tags : "resolved_by_emp_id"
    users |o--o{ purchase_order_tags : "tagged_by_emp_id"
    tracker_tags ||--o{ purchase_order_tags : "tracker_tag_id"
    purchase_requests ||--o{ purchase_request_items : "purchase_request_id"
    users |o--o{ purchase_requests : "cancelled_by_emp_id"
    status ||--o{ purchase_requests : "status"
    users |o--o{ purchase_requests : "verify_by_emp_id"
    record_classes ||--o{ records : "record_class_id"
    users ||--o{ saved_queries : "created_by_emp_id"
    role ||--o{ users : "role_id"
